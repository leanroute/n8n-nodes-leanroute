{
  "name": "n8n-nodes-leanroute",
  "version": "0.1.5",
  "description": "n8n community node for Leanroute AI Gateway: 100+ LLMs, smart routing, semantic caching, and failover",
  "keywords": [
    "n8n-community-node-package",
    "leanroute",
    "ai-gateway",
    "llm",
    "deepseek",
    "openai",
    "claude"
  ],
  "license": "MIT",
  "homepage": "https://leanroute.dev",
  "author": {
    "name": "Leanroute",
    "email": "support@leanroute.dev",
    "url": "https://leanroute.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leanroute/n8n-nodes-leanroute.git"
  },
  "bugs": { "url": "https://github.com/leanroute/n8n-nodes-leanroute/issues" },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/LeanrouteApi.credentials.js"],
    "nodes": [
      "dist/nodes/Leanroute/LeanrouteChatModel.node.js",
      "dist/nodes/Leanroute/Leanroute.node.js"
    ],
    "strict": false
  },
  "dependencies": {
    "@langchain/openai": "^0.3.0",
    "@langchain/core": "^0.3.0"
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": { "n8n-workflow": "*" }
}
