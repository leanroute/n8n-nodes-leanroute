{
    "name": "n8n-nodes-leanroute",
    "version": "0.1.4",
    "description": "n8n community node for Leanroute AI Gateway: 100+ LLMs, smart routing, semantic caching, and failover",
    "keywords": [
        "n8n-community-node-package",
        "leanroute",
        "ai-gateway",
        "llm",
        "deepseek",
        "openai",
        "claude"
    ],
    "license": "MIT",
    "homepage": "https://leanroute.dev",
    "author": {
        "name": "Leanroute",
        "email": "support@leanroute.dev",
        "url": "https://leanroute.dev"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/leanroute/n8n-nodes-leanroute.git"
    },
    "bugs": {
        "url": "https://github.com/leanroute/n8n-nodes-leanroute/issues"
    },
    "main": "index.js",
    "scripts": {
        "build": "tsc && node -e \"const fs=require('fs');const f=s=>!s.endsWith('.ts');fs.cpSync('nodes','dist/nodes',{recursive:true,filter:f});fs.cpSync('credentials','dist/credentials',{recursive:true,filter:f})\"",
        "dev": "tsc --watch",
        "prepublishOnly": "npm run build"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "credentials": [
            "dist/credentials/LeanrouteApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Leanroute/LeanrouteChatModel.node.js",
            "dist/nodes/Leanroute/Leanroute.node.js"
        ]
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "n8n-workflow": "^1.25.0",
        "typescript": "^5.3.3"
    },
    "dependencies": {
        "@langchain/openai": "^0.3.0",
        "@langchain/core": "^0.3.0"
    }
}
